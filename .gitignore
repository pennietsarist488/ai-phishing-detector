# AI钓鱼网站检测系统 - Git忽略规则
# ====================================

# Python 字节码缓存
__pycache__/
*.py[cod]
*$py.class
*.pyo

# 虚拟环境
venv/
env/
.venv/
.env

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 日志文件
logs/
*.log

# 模型训练临时文件
training/__pycache__/
models/*.pth.bak

# 测试覆盖率报告
.coverage
htmlcov/

# 系统临时文件
.DS_Store
Thumbs.db

# 环境变量文件（包含敏感信息）
.env.local
.env.production

# 数据集目录（可能包含大量数据）
钓鱼网站URL数据集/

# Chrome 扩展打包文件
*.crx
*.pem

# Docker 构建缓存
.docker/

# 临时测试文件
test_temp/
tmp/